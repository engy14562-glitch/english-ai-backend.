# ==== Server ====
PORT=8080
NODE_ENV=production

# ==== OpenAI (Whisper STT + GPT chat) ====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ==== ElevenLabs (TTS) ====
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==== RevenueCat ====
# Used to verify inbound webhook authenticity (RevenueCat sends this
# as a Bearer token in the Authorization header of each webhook call).
REVENUECAT_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Used server-side to query subscriber status directly (v1 REST API).
REVENUECAT_SECRET_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# ==== Auth (verifying the app's logged-in user on every request) ====
# Recommended: use Firebase Auth (or your existing auth provider) and
# verify ID tokens server-side. Firebase service account JSON path:
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ==== Free-tier daily limit enforcement ====
FREE_TIER_DAILY_SECONDS=300
